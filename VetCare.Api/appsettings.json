{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    // No password here, ever. Development: `dotnet user-secrets set
    // "ConnectionStrings:DefaultConnection" "..."` (see README). Production:
    // set the ConnectionStrings__DefaultConnection environment variable.
    "DefaultConnection": "Host=localhost;Port=5432;Database=vetcare;Username=vetcare_app;Password="
  },
  "ProductImages": {
    // Physical folder product images are served from. In production, point
    // this (via the PRODUCTIMAGES__PATH env var) at a persistent disk.
    "Path": "product-images"
  }
}
